# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Se estiver rodando dentro do Lovable com o Supabase
# conectado nativamente, essas variáveis já são preenchidas automaticamente
# e este arquivo pode ser ignorado.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
